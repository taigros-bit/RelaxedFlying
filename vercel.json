{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "early-access.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/subscribe", "dest": "/api/subscribe.js" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/early-access.html", "dest": "/early-access.html" },
    { "src": "/early-access", "dest": "/early-access.html" },
    { "src": "/app", "dest": "/index.html" },
    { "src": "/demo", "dest": "/index.html" },
    { "src": "/", "dest": "/early-access.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
